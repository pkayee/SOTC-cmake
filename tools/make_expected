#!/usr/bin/env python3
"""make_expected [--baseline REF] [--keep] — build the objdiff reference objects (expected/) from the ORIGINAL bytes.

tools/score compares your compiled C against expected/<MODULE>/src/<MODULE>/<file>.c.o. For a function that is still
INCLUDE_ASM those bytes are the original game code, so `cp -r build expected` after a green `make` is enough while
you work on unmatched functions. To RE-VERIFY already-matched functions you need the reference from before they were
matched: this tool copies the tree to a scratch dir, puts every function added since REF (default 59b47f6, the upstream
baseline) back to INCLUDE_ASM, builds that (the module checksums may be red there: only objects matter) and installs the
objects as ./expected. Takes a few minutes. Env: SOTC_ROOT (default repo root)."""
import argparse, os, re, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(os.environ.get("SOTC_ROOT", Path(__file__).resolve().parents[1]))
CDEF = re.compile(r"^\+(?!extern\b|typedef\b|INCLUDE_ASM|\+)[A-Za-z_][\w \*]* \**([A-Za-z_]\w*)\s*\([^;]*$")

def body_end(lines, j):
    depth, seen, k = 0, False, j
    while k < len(lines):
        s = re.sub(r'"(?:\\.|[^"\\])*"', '""', lines[k]); s = re.sub(r"'(?:\\.|[^'\\])'", "''", s)
        depth += s.count("{") - s.count("}"); seen |= "{" in s; k += 1
        if seen and depth == 0: return k
    return None

def restore(path, mod, rel, names):
    lines = path.read_text(errors="replace").split("\n"); n = 0
    for name in names:
        pat = re.compile(r"^(?!static\b|extern\b|typedef\b|INCLUDE_ASM)[A-Za-z_][\w \*]*?\b" + re.escape(name) + r"\s*\([^;]*$")
        i = next((i for i, l in enumerate(lines) if pat.match(l)), None)
        if i is None: continue
        k = body_end(lines, i)
        if k is None: continue
        inc = f'INCLUDE_ASM("asm/{mod}/nonmatchings/{rel}", {name});'
        j = i - 1
        while j >= 0 and not lines[j].strip(): j -= 1
        if j >= 0 and re.match(r"\s*//\s*INCLUDE_ASM\(.*,\s*" + re.escape(name) + r"\)", lines[j]): i = j
        lines[i:k] = [inc]; n += 1
    path.write_text("\n".join(lines)); return n

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--baseline", default="59b47f6"); ap.add_argument("--keep", action="store_true", help="keep the scratch dir")
    ap.add_argument("--queue", default=str(ROOT / "build/functions.jsonl"))
    o = ap.parse_args()
    import json
    diff = subprocess.run(["git", "-C", str(ROOT), "diff", "-U0", o.baseline, "HEAD", "--", "src"], capture_output=True, text=True, check=True).stdout
    added = {m.group(1) for m in map(CDEF.match, diff.splitlines()) if m}
    q = [json.loads(l) for l in Path(o.queue).read_text().splitlines() if l.strip()]
    todo = {}
    for r in q:
        if r["status"] == "matched" and r["name"] in added: todo.setdefault((r["module"], r["file"]), []).append(r["name"])
    tmp = Path(tempfile.mkdtemp(prefix="sotc_expected_"))
    files = subprocess.run(["git", "-C", str(ROOT), "ls-files", "-z"], capture_output=True).stdout.split(b"\0")
    for f in files:
        if not f: continue
        s = ROOT / f.decode()
        if not s.is_file() and not s.is_symlink(): continue
        d = tmp / f.decode(); d.parent.mkdir(parents=True, exist_ok=True); shutil.copy2(s, d, follow_symlinks=False)
    for extra in ("tools/cc",):
        if (ROOT / extra).is_dir(): shutil.copytree(ROOT / extra, tmp / extra, symlinks=True, dirs_exist_ok=True)
    for ln in ("iso", ".python3"):
        if (ROOT / ln).exists(): (tmp / ln).symlink_to((ROOT / ln).resolve())
    total = sum(restore(tmp / "src" / m / (f + ".c"), m, f, names) for (m, f), names in todo.items())
    print(f"make_expected: {total} functions put back to INCLUDE_ASM in {tmp}", file=sys.stderr)
    env = dict(os.environ); env.pop("DECOMP_DIR", None)
    subprocess.run(["make", "-k", "-j1"], cwd=tmp, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)  # checksums may be red here
    if not (tmp / "build").is_dir(): sys.exit(f"make_expected: no build/ in {tmp}")
    shutil.rmtree(ROOT / "expected", ignore_errors=True); shutil.copytree(tmp / "build", ROOT / "expected", symlinks=True)
    print(f"make_expected: expected/ installed from {tmp}/build", file=sys.stderr)
    if not o.keep: shutil.rmtree(tmp, ignore_errors=True)
main()
